# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3000

# Required for the admin panel (/admin.html) to authenticate
ADMIN_PASSWORD=choose_a_strong_password

# Required for ZIP-based "near me" search (/api/nearby) — without it,
# nearby lookups return a 503 and fall back to showing all national chains
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Optional — defaults to ./db locally; set to a persistent disk path in production
DATA_DIR=./db
